# Gitverse API credentials for e2e tests
# Copy this file to .env and fill in your values

# Base URL of your Gitverse/Gitea instance
GITVERSE_BASE_URL=https://gitverse.ru

# Personal Access Token with repo scope
GITVERSE_TOKEN=ghp_your_token_here

# Test repository (will be used for CRUD operations)
# Format: owner/repo
GITVERSE_TEST_REPO=RadinAnton/n8n-nodes-gitverse-test
