# Gitverse API credentials for local smoke tests / e2e
# Copy this file to .env and fill in your values

# Base URL of the Gitverse API (the web UI host does not serve the API)
GITVERSE_BASE_URL=https://api.gitverse.ru

# Personal Access Token with repo scope
GITVERSE_TOKEN=your_token_here

# Test repository (used for CRUD operations)
# Format: owner/repo
GITVERSE_TEST_REPO=owner/test-repo
